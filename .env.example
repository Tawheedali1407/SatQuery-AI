# Copy to backend/.env and adjust. All settings are optional.
SATQUERY_MAX_ANALYSIS_PX=2048      # longest side analysed; bigger scenes are read via overviews
SATQUERY_MAX_UPLOAD_MB=512
SATQUERY_VQA_BACKEND=auto          # auto | rules | blip  (blip needs requirements-ml.txt)
SATQUERY_BLIP_MODEL=Salesforce/blip-vqa-base
# SATQUERY_CORS_ORIGINS=["https://your-frontend.netlify.app"]

# Frontend (frontend/.env) — only when the UI is hosted separately from the API:
# VITE_API_URL=https://your-backend.example.com
