# Copy to backend/.env and adjust. Everything is optional; with no changes the app runs fully offline on CPU.
SATQUERY_MAX_ANALYSIS_PX=2048      # longest side analysed; bigger scenes are read via overviews
SATQUERY_MAX_UPLOAD_MB=512

# Change detection: auto uses ChangeFormer (if fetched) for imagery at <= 2 m/px, classical otherwise
SATQUERY_CHANGE_BACKEND=auto       # auto | classical | changeformer
SATQUERY_CHANGE_MAX_GSD_M=2.0
SATQUERY_TORCH_THREADS=0           # 0 = torch default

# Open-ended questions: gemini (if key set) -> blip (if installed) -> rule-based answers
SATQUERY_VQA_BACKEND=auto          # auto | rules | blip | gemini
# Free key: https://aistudio.google.com/apikey  (the image + question are sent to Google)
SATQUERY_GEMINI_API_KEY=
SATQUERY_GEMINI_MODEL=gemini-2.5-flash

# SATQUERY_CORS_ORIGINS=["https://your-frontend.netlify.app"]

# Frontend (frontend/.env) — only when the UI is hosted separately from the API:
# VITE_API_URL=https://your-backend.example.com
